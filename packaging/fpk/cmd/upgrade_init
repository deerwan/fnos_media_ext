#!/bin/bash
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"
if [ -n "${REPO_DIR}" ] && [ -d "${REPO_DIR}/state" ]; then
    BACKUP_DIR="${TRIM_PKGVAR:-/tmp}/fnos-media-upgrade"
    mkdir -p "${BACKUP_DIR}"
    tar -czf "${BACKUP_DIR}/state.tar.gz" -C "${REPO_DIR}" state
fi
exit 0
